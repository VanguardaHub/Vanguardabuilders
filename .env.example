# =============================================================================
# Vanguarda Builder — variáveis de ambiente (exemplo)
# =============================================================================
# App TanStack Start (SSR + nitro). Há variáveis de BUILD (client, prefixo VITE_)
# e de RUNTIME (server, SEM prefixo VITE_). Na Vercel, cadastre TODAS em
# Project Settings > Environment Variables (Production e Preview).
#
# NUNCA coloque service_role, senhas ou segredos em variáveis VITE_*: tudo que
# começa com VITE_ é embutido no bundle do navegador e fica público.
# -----------------------------------------------------------------------------

# --- Client (build-time, expostas ao browser) --------------------------------
# Lidas em src/integrations/supabase/client.ts via import.meta.env
VITE_SUPABASE_URL="https://<PROJECT_REF>.supabase.co"
VITE_SUPABASE_PUBLISHABLE_KEY="<anon_ou_publishable_key>"
VITE_SUPABASE_PROJECT_ID="<PROJECT_REF>"

# --- Server (runtime, NUNCA expostas ao browser) -----------------------------
# Fallback SSR do client (src/integrations/supabase/client.ts) e client admin
# (src/integrations/supabase/client.server.ts). Use os MESMOS valores do projeto.
SUPABASE_URL="https://<PROJECT_REF>.supabase.co"
SUPABASE_PUBLISHABLE_KEY="<anon_ou_publishable_key>"
# SEGREDO — bypassa RLS. Só no servidor. Jamais em VITE_ nem no client.
SUPABASE_SERVICE_ROLE_KEY="<service_role_key>"

# --- IA / Gateway -------------------------------------------------------------
# Usado por src/lib/ai-gateway.server.ts -> https://ai.gateway.lovable.dev/v1
# Este gateway é gerenciado pelo Lovable. Ao sair do Lovable, decida:
#   (a) manter uma Lovable API Key válida, ou
#   (b) trocar por um provider OpenAI-compatível direto (ex.: OpenAI/OpenRouter),
#       ajustando baseURL/headers em src/lib/ai-gateway.server.ts.
LOVABLE_API_KEY="<lovable_api_key_ou_equivalente>"
